<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <PackageId>Lunixi.Sdk</PackageId>
    <Version>1.0.1</Version>
    <Authors>Lunixi</Authors>
    <Description>Lunixi server-side .NET SDK: signed requests, hosted payment intents, payment operations, fraud and verified webhooks.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Lunixi-Payment/lunixi-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://lunixi.com</PackageProjectUrl>
    <PackageTags>lunixi;payments;dotnet;sdk;ed25519;webhooks</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../MIGRATION-1.0.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../.github/assets/*.svg" Pack="true" PackagePath=".github/assets/" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
